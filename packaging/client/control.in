Package: zherodizk-client
Version: @VERSION@
Section: net
Priority: optional
Architecture: amd64
Depends: python3, libgtk-3-0, libxdo3 | libxdo4, libxcb-randr0, libxcb-shape0, libxcb-xfixes0, libxfixes3, libasound2 | libasound2t64, libpulse0, libva2, libva-drm2, libva-x11-2, libayatana-appindicator3-1 | libappindicator3-1, libgstreamer1.0-0, libgstreamer-plugins-base1.0-0

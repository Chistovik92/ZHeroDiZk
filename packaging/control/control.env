# ZHeroDiZk control server settings. This file holds secrets: keep it readable only by root
# and the zherodizk-control group (the package sets mode 0640).
#
# PostgreSQL 16 connection. Create the role and database first, see docs/SERVER.md.
ZHD_DATABASE_URL=postgres://zherodizk:CHANGE_ME@127.0.0.1/zherodizk
# Listen on loopback only and put a reverse proxy with TLS in front (examples in
# /usr/share/doc/zherodizk-control). Never expose this port to the internet without TLS.
ZHD_LISTEN=127.0.0.1:21114
# false: only the very first account can be created through the API.
ZHD_ALLOW_REGISTRATION=false
# Anonymous requests per minute and address (0 = off).
ZHD_AUTH_RATE_LIMIT=30
# true only when a trusted reverse proxy sets X-Forwarded-For.
ZHD_TRUST_FORWARDED_FOR=false
# Keys (32 random bytes, base64): create them with zherodizk-control generate-keys.
# Without ZHD_MFA_KEY multi-factor authentication is unavailable; without ZHD_GRANT_KEY session
# grants cannot be issued. Losing ZHD_MFA_KEY makes stored second-factor secrets unusable.
ZHD_MFA_KEY=
ZHD_GRANT_KEY=

# ZHeroDiZk server settings, read by both services.
#
# Arguments for the rendezvous server (zhd-rendezvous --help).
# Example: -r relay.example.org -k _
ZHD_RENDEZVOUS_ARGS=-k _
#
# Arguments for the relay server (zhd-relay --help).
ZHD_RELAY_ARGS=-k _
#
# "-k _" makes the servers accept only clients that carry the server public key
# (it is created on first start in /var/lib/zherodizk/id_ed25519.pub).
